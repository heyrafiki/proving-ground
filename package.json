{
  "name": "@heyrafiki/proving-ground",
  "version": "0.1.0",
  "private": true,
  "description": "Executable conformance evidence for the Heyrafiki contract.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyrafiki/proving-ground.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "test": "npm run verify:lock && npm run lint && node scripts/check-contract.mjs && npm run test:financial-controls && npm run test:assurance && npm run benchmark",
    "test:financial-controls": "node scripts/check-financial-controls.mjs && node scripts/check-claim-valuation-timeline.mjs",
    "test:assurance": "node scripts/check-assurance-graph.mjs",
    "benchmark": "node scripts/run-assurance-benchmark.mjs",
    "verify:lock": "node scripts/check-contract-lock.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.44.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
